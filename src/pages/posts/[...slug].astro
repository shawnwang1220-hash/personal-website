---
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE } from "../../site.config";

export const getStaticPaths = (async () => {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  const sorted = posts.sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );

  return sorted.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      prev: sorted[i - 1] ?? null,
      next: sorted[i + 1] ?? null,
    },
  }));
}) satisfies GetStaticPaths;

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, tags } = post.data;

const dateText = pubDate.toISOString().slice(0, 10);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  inLanguage: "zh-CN",
  keywords: tags.join(", "),
  url: new URL(`/posts/${post.id}`, SITE.url).href,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": new URL(`/posts/${post.id}`, SITE.url).href,
  },
  author: { "@id": `${SITE.url}/#person` },
  publisher: { "@id": `${SITE.url}/#person` },
};
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  jsonLd={jsonLd}
>
  <section class="section container" style="max-width: 780px;">
    <a class="back-link" href="/posts">← 返回文章列表</a>

    <article class="card reveal">
      <header class="post-head">
        <h1>{title}</h1>
        <div class="post-meta">
          <time datetime={pubDate.toISOString()}>{dateText}</time>
          {
            tags.length > 0 && (
              <>
                <span class="dot"></span>
                <span class="post-tags">
                  {tags.map((t) => (
                    <a class="tag" href={`/tags/${encodeURIComponent(t)}`}>{t}</a>
                  ))}
                </span>
              </>
            )
          }
        </div>
      </header>

      <div class="markdown-body">
        <Content />
      </div>
    </article>

    <nav class="post-nav">
      {prev ? <a href={`/posts/${prev.id}`}>← {prev.data.title}</a> : <span></span>}
      {next ? <a href={`/posts/${next.id}`}>{next.data.title} →</a> : <span></span>}
    </nav>
  </section>
</BaseLayout>
