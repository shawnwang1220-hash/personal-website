---
import BaseLayout from "../layouts/BaseLayout.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { SITE } from "../site.config";
import { withTrailingSlash } from "../i18n/config";

const description =
  "王天旭的在线简历 —— 7 年 B2B 数字营销经验，专注海外数字化获客体系与 Marketing Technology 建设。";

/** 邮箱/电话从 site.config 读取；占位符（含 example.com）不生成 mailto 死链 */
const email = SITE.author.email;
const phone = SITE.author.phone;
const phoneText = phone || "电话待补充";

/** 简历 PDF 站点路径；空 = 仅打印导出 */
const resumePdf = SITE.resumePdf;

const resumeUrl = new URL(withTrailingSlash("/resume/"), SITE.url).href;

/** 占位邮箱不写进结构化数据，避免对外输出一个无效联系地址 */
const schemaEmail =
  email && !email.includes("example.com") ? `mailto:${email}` : undefined;

/** 电话按 E.164 输出；页面上保留可读的空格分组 */
const schemaPhone = phone ? `+${phone.replace(/\D/g, "")}` : undefined;

/**
 * 简历页的结构化数据。
 *
 * ProfilePage 把「这个 URL 是某人的资料页」显式表达出来；Person 节点与
 * BaseLayout 注入的精简版同 @id，布局会**按字段合并** —— 所以这里只声明简历页
 * 独有的字段（email / telephone / hasOccupation / alumniOf），不重抄 name、jobTitle、
 * sameAs、knowsAbout。
 *
 * 刻意不塞工作经历：schema.org 对「历史任职」没有简洁准确的表达（worksFor 的
 * 语义是「目前为之工作」，拿它列历史雇主等于给出错误事实），而简历正文本身是
 * H2 分节 + 列表，对抓取已经足够清楚。结构化数据只补正文表达不了的实体信息。
 */
const PERSON_ID = `${SITE.url}/#person`;
const jsonLd = [
  {
    "@type": "ProfilePage",
    "@id": `${resumeUrl}#profilepage`,
    url: resumeUrl,
    name: "王天旭的个人简历",
    description,
    inLanguage: "zh-CN",
    isPartOf: { "@id": `${SITE.url}/#website` },
    about: { "@id": PERSON_ID },
    mainEntity: { "@id": PERSON_ID },
  },
  {
    "@type": "Person",
    "@id": PERSON_ID,
    ...(schemaEmail ? { email: schemaEmail } : {}),
    ...(schemaPhone ? { telephone: schemaPhone } : {}),
    hasOccupation: {
      "@type": "Occupation",
      name: SITE.author.role,
      occupationLocation: { "@type": "Country", name: "中国" },
    },
    alumniOf: [
      { "@type": "CollegeOrUniversity", name: "英国诺丁汉大学" },
      { "@type": "CollegeOrUniversity", name: "中国农业大学" },
    ],
  },
];
---

<BaseLayout title="个人简历" description={description} ogType="article" jsonLd={jsonLd}>
  <div class="resume-wrap">
<div class="resume" id="resume">
      <!-- 头部：姓名 + 联系方式 -->
      <header class="resume-header">
        <div>
          <h1 class="resume-name">王天旭</h1>
          <p class="resume-role">数字营销 &amp; MarTech 顾问 · 海外 B2B 获客</p>
        </div>
        <div class="resume-contact">
          <div class="row"><span>电话：{phoneText}</span></div>
          <div class="row">
            <span
              >邮箱：{
                !email || email.includes("example.com") ? (
                  email || "邮箱待补充"
                ) : (
                  <a href={`mailto:${email}`}>{email}</a>
                )
              }</span
            >
          </div>
          <div class="row"><span>所在地：北京</span><span>性别：男</span><span>学历：硕士</span></div>
          <div class="row resume-socials">
            <SocialLinks only={["linkedin", "github"]} person={SITE.author.name} lang="zh" externalHint={false} />
          </div>
        </div>
      </header>

      <!-- 自我评价 -->
      <section class="r-section">
        <h2 class="r-h">自我评价</h2>
        <p class="r-summary">
          7 年 B2B 数字营销经验，专注于企业数字化获客体系及营销运营建设。具备成熟 B2B SaaS 企业营销体系持续优化经验，
          同时拥有传统企业海外数字营销体系 0-1 建设实践。熟悉 Google Ads、Salesforce、Pardot、GA4、GTM 等 MarTech 平台，
          能够独立推动数字化获客、营销自动化、CRM 运营及 Lead Management 全流程持续优化。
        </p>
      </section>

      <!-- 工作经历 -->
      <section class="r-section">
        <h2 class="r-h">工作经历</h2>

        <div class="job">
          <div class="job-head">
            <span class="job-title">独立数字营销与 MarTech 顾问</span>
            <span class="job-date">2025.10 - 至今</span>
          </div>
          <ul class="job-points">
            <li><strong>个人站全链路：</strong>搭建个人站 tianxu.uk（Astro + Cloudflare，AI 辅助开发），作为营销技术栈试验场，跑通站点、表单、追踪全链路。</li>
            <li><strong>表单到服务端链路：</strong>自建表单到服务端链路，提交同时写入 Cloudflare D1 与 Notion；用隐藏字段将 GA4 Client ID 存入线索记录，并在 GA4 DebugView 验证。</li>
            <li><strong>Web 与 Server-Side 追踪：</strong>配置 GTM + GA4 Web 端追踪，自建 Server-Side GTM 测试环境（Stape），初步跑通 GA4 服务端转发。</li>
            <li><strong>排障与复盘：</strong>独立排查 GA4 page_view 丢失（其他事件正常、无请求发出），定位到 Google 标签中手填 session_id / session_number 覆盖了 GA4 会话参数，修复后回归验证通过，并整理成公开复盘文章。</li>
            <li>基于 Dify、Notion 等 AI 与自动化工具搭建个人工作流，将网页、文档等非结构化信息提取、整理并转换为结构化数据，形成可复用的信息处理流程。</li>
          </ul>
        </div>

        <div class="job">
          <div class="job-head">
            <span class="job-title">博睿数据</span>
            <span class="job-date">2025.01 - 2025.09</span>
          </div>
          <div class="job-meta">Overseas Digital Marketing ｜ 计算机软件</div>
          <ul class="job-points">
            <li>企业海外业务 0-1 阶段，负责数字化获客体系及 Marketing Technology 建设，支撑海外市场启动。</li>
            <li><strong>海外数字营销体系 0-1 建设：</strong>独立规划并落地官网、广告平台、Marketing Stack 及 Lead Management 流程，为海外业务建立完整的数字化获客基础设施。</li>
            <li><strong>Marketing Stack 建设：</strong>独立完成 Google Ads、LinkedIn Ads、GA4、GTM、Zoho Forms 及纷享销客等营销平台部署与实施，打通营销 Tracking、线索采集及基础数据流。</li>
            <li><strong>Marketing Automation &amp; CRM：</strong>设计海外线索管理流程，搭建表单自动化、邮件通知、数据同步及 Lead Routing 机制，提升海外线索流转效率。</li>
            <li><strong>海外品牌与运营支持：</strong>负责海外官网、LinkedIn 企业主页及 PR 发布等运营工作，持续完善企业海外品牌曝光及数字化运营能力。</li>
          </ul>
        </div>

        <div class="job">
          <div class="job-head">
            <span class="job-title">氦图科技 / hireEZ</span>
            <span class="job-date">2021.05 - 2024.07</span>
          </div>
          <div class="job-meta">Sr. Marketing Operations ｜ IT 服务</div>
          <ul class="job-points">
            <li>全球 B2B AI 招聘 SaaS 企业，负责北美及全球市场 Marketing Operations，覆盖数字化获客、营销数据追踪、CRM 与线索运营及营销自动化。</li>
            <li><strong>数字化获客：</strong>负责全球 B2B AI 招聘 SaaS 海外市场获客，运营 Google Ads、LinkedIn Ads 等渠道，年度广告投放规模约 80 万美元；推动 Google Ads ROAS 从 3.7 提升至 14.32（约 3.87 倍），助力公司 ARR 增长 2.5 倍。</li>
            <li><strong>营销数据追踪：</strong>主导 Universal Analytics 向 GA4 迁移，维护 GTM 网站数据采集及广告追踪配置，支持渠道效果监测、转化分析与投放优化。</li>
            <li><strong>CRM 运营：</strong>负责 Salesforce CRM 日常运营与配置，维护 Lead、Contact、Account、Campaign、Opportunity 等核心业务数据，优化字段配置、数据校验规则及用户权限管理。</li>
            <li><strong>线索管理与分配：</strong>参与维护 LeanData 线索分配规则，依据客户匹配、区域及公司规模等条件进行线索分配，通过路由日志排查错误分配及线索流转异常。</li>
            <li><strong>销售运营报表：</strong>建设 Salesforce 自定义报表与 Dashboard，监控销售 Pipeline、SDR 负责客户状态及线索表现，结合 Excel 开展跨系统数据核对与分析，为业务团队提供数据支持。</li>
            <li><strong>CRM 数据分析：</strong>使用 CRM Analytics 整合 Salesforce、Pardot 及 GA4 数据，完成多来源数据关联、清洗和汇总，建设营销与销售数据看板，并将整理后的最新营销活动信息回写 CRM 客户记录。</li>
            <li><strong>营销自动化：</strong>负责 Pardot 日常运营，配置营销表单、线索处理动作及项目型受众分流，支持产品发布、展会等营销活动的线索管理与后续协同。</li>
            <li><strong>ABM 客户运营：</strong>参与 6sense ABM 运营，根据目标客户特征及销售需求维护客户分群，并将分群数据同步至 Salesforce，支持精准营销与销售协同。</li>
          </ul>
        </div>

        <div class="job">
          <div class="job-head"><span class="job-title">优必科技</span><span class="job-date">2021.03 - 2021.05</span></div>
          <div class="job-meta">海外投放经理 ｜ IT 服务</div>
        </div>
        <div class="job">
          <div class="job-head"><span class="job-title">海石互动</span><span class="job-date">2020.05 - 2021.03</span></div>
          <div class="job-meta">海外渠道优化师</div>
        </div>
        <div class="job">
          <div class="job-head"><span class="job-title">鑫互联科技</span><span class="job-date">2019.02 - 2020.01</span></div>
          <div class="job-meta">优化师 ｜ IT 服务</div>
        </div>
        <div class="job">
          <div class="job-head"><span class="job-title">承德露露</span><span class="job-date">2017.11 - 2018.10</span></div>
          <div class="job-meta">新媒体专员 ｜ 快速消费品</div>
        </div>
        <div class="job">
          <div class="job-head"><span class="job-title">北京德农</span><span class="job-date">2017.05 - 2017.11</span></div>
          <div class="job-meta">科研助理</div>
        </div>
      </section>

      <!-- 相关技能 -->
      <section class="r-section" id="skills">
        <h2 class="r-h">相关技能</h2>
        <div class="skill-group">
          <span class="skill-label">职能方向</span>
          <span class="skill-items">Marketing Operations ｜ Marketing Systems ｜ Marketing Automation ｜ CRM</span>
        </div>
        <div class="skill-group">
          <span class="skill-label">工具平台</span>
          <div class="tags">
            <span class="tag">Google Ads</span><span class="tag">LinkedIn Ads</span><span class="tag">GA4</span>
            <span class="tag">Google Tag Manager</span><span class="tag">Server-Side GTM</span><span class="tag">Salesforce</span><span class="tag">Pardot</span>
            <span class="tag">6sense</span><span class="tag">Zoho</span><span class="tag">纷享销客</span>
          </div>
        </div>
        <div class="skill-group">
          <span class="skill-label">数据与分析</span>
          <span class="skill-items">Lead Management ｜ Marketing Analytics ｜ SQL ｜ Looker Studio ｜ CRMA</span>
        </div>
      </section>

      <!-- 教育经历 -->
      <section class="r-section" id="contact">
        <h2 class="r-h">教育经历</h2>
        <div class="edu-item">
          <span><span class="edu-name">英国诺丁汉大学</span> <span class="edu-degree">农学 · 硕士</span></span>
          <span class="edu-date">2015.09 - 2016.12</span>
        </div>
        <div class="edu-item">
          <span><span class="edu-name">中国农业大学</span> <span class="edu-degree">农学 · 学士</span></span>
          <span class="edu-date">2011.09 - 2015.07</span>
        </div>
      </section>

      <div class="resume-actions">
        {
          resumePdf ? (
            <>
              <a class="btn btn-primary" href={resumePdf} download>下载 PDF</a>
              <button class="btn btn-ghost" id="printBtn" type="button">打印</button>
            </>
          ) : (
            <button class="btn btn-primary" id="printBtn" type="button">下载 / 打印 PDF</button>
          )
        }
      </div>
    </div>
  </div>
</BaseLayout>

{/* is:inline：不让 Astro/Vite 打包压缩，构建产物里保持可读 */}
<script is:inline>
  /* 打印 / 导出 PDF —— 用浏览器原生打印，不引入额外依赖 */
  document.getElementById("printBtn")?.addEventListener("click", () => window.print());
</script>
