---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CaseCard from "../../../components/CaseCard.astro";
import { getUiCopy } from "../../../i18n/ui";

const lang = "en" as const;
const t = getUiCopy(lang);

const items = (await getCollection("casesEn")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout lang={lang} title={t.case.pageTitle} description={t.case.pageDescription}>
  <div class="section container">
    <div class="page-head">
      <h1>{t.case.heading}</h1>
      <p class="section-sub">{t.case.intro}</p>
    </div>

    {
      items.length > 0 ? (
        <div class="case-grid">
          {items.map((item) => (
            <CaseCard item={item} lang={lang} as="h2" />
          ))}
        </div>
      ) : (
        <p>{t.case.empty}</p>
      )
    }
  </div>
</BaseLayout>
