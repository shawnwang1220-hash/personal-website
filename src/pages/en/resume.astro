---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SocialLinks from "../../components/SocialLinks.astro";
import { SITE } from "../../site.config";
import { getSiteCopy } from "../../i18n/ui";
import { withTrailingSlash } from "../../i18n/config";

const lang = "en" as const;
const copy = getSiteCopy(lang);

const description =
  "Shawn Wang's résumé — 7 years in B2B digital marketing, focused on global demand generation systems and marketing technology.";

/** 邮箱/电话从 site.config 读取；占位符（含 example.com）不生成 mailto 死链 */
const email = copy.author.email;
const phone = copy.author.phone;
const phoneText = phone || "Available on request";

/** Résumé PDF site path; empty = print-only export */
const resumePdf = SITE.resumePdf;

const resumeUrl = new URL(withTrailingSlash("/en/resume/"), SITE.url).href;

/** 占位邮箱不写进结构化数据，避免对外输出一个无效联系地址 */
const schemaEmail =
  email && !email.includes("example.com") ? `mailto:${email}` : undefined;

/** 电话按 E.164 输出；页面上保留可读的空格分组 */
const schemaPhone = phone ? `+${phone.replace(/\D/g, "")}` : undefined;

/**
 * 简历页的结构化数据。与中文简历页同构，仅语言相关的字段取值不同。
 *
 * ProfilePage 把「这个 URL 是某人的资料页」显式表达出来；Person 节点与
 * BaseLayout 注入的精简版同 @id，布局会**按字段合并** —— 所以这里只声明简历页
 * 独有的字段（email / telephone / hasOccupation / alumniOf），不重抄 name、jobTitle、
 * sameAs、knowsAbout。
 *
 * 刻意不塞工作经历：schema.org 对历史任职没有简洁准确的表达（worksFor 的语义是
 * 「目前为之工作」），而简历正文本身已经是清晰的分节列表。
 */
const PERSON_ID = `${SITE.url}/#person`;
const jsonLd = [
  {
    "@type": "ProfilePage",
    "@id": `${resumeUrl}#profilepage`,
    url: resumeUrl,
    name: "Shawn Wang's Résumé",
    description,
    inLanguage: "en",
    isPartOf: { "@id": `${SITE.url}/#website` },
    about: { "@id": PERSON_ID },
    mainEntity: { "@id": PERSON_ID },
  },
  {
    "@type": "Person",
    "@id": PERSON_ID,
    ...(schemaEmail ? { email: schemaEmail } : {}),
    ...(schemaPhone ? { telephone: schemaPhone } : {}),
    hasOccupation: {
      "@type": "Occupation",
      name: copy.author.role,
      occupationLocation: { "@type": "Country", name: "China" },
    },
    alumniOf: [
      { "@type": "CollegeOrUniversity", name: "University of Nottingham" },
      { "@type": "CollegeOrUniversity", name: "China Agricultural University" },
    ],
  },
];
---

<BaseLayout lang={lang} title="Résumé" description={description} ogType="article" jsonLd={jsonLd}>
  <div class="resume-wrap">
<div class="resume" id="resume">
      <!-- Header: name + contact -->
      <header class="resume-header">
        <div>
          <h1 class="resume-name">Shawn Wang</h1>
          <p class="resume-role">Digital Marketing &amp; MarTech Consultant · Global B2B Demand Generation</p>
        </div>
        <div class="resume-contact">
          <div class="row"><span>Phone: {phoneText}</span></div>
          <div class="row">
            <span
              >Email: {
                !email || email.includes("example.com") ? (
                  email || "Available on request"
                ) : (
                  <a href={`mailto:${email}`}>{email}</a>
                )
              }</span
            >
          </div>
          <div class="row"><span>Location: Beijing, China</span><span>Gender: Male</span><span>Degree: Master’s</span></div>
          <div class="row resume-socials">
            <SocialLinks only={["linkedin", "github"]} person={copy.author.name} lang={lang} externalHint={false} />
          </div>
        </div>
      </header>

      <!-- Summary -->
      <section class="r-section">
        <h2 class="r-h">Summary</h2>
        <p class="r-summary">
          7 years of B2B digital marketing experience, focused on building enterprise demand generation
          systems and marketing operations. Experienced in continuously optimizing the marketing stack of
          mature B2B SaaS companies, as well as building a global digital marketing system from zero for a
          traditional enterprise. Fluent across MarTech platforms including Google Ads, Salesforce, Pardot,
          GA4 and GTM, with a track record of independently driving end-to-end improvement across demand
          generation, marketing automation, CRM operations and lead management.
        </p>
      </section>

      <!-- Experience -->
      <section class="r-section">
        <h2 class="r-h">Experience</h2>

        <div class="job">
          <div class="job-head">
            <span class="job-title">Independent Digital Marketing &amp; MarTech Consultant</span>
            <span class="job-date">Oct 2025 - Present</span>
          </div>
          <ul class="job-points">
            <li><strong>Personal site, end to end:</strong> Built tianxu.uk (Astro + Cloudflare, AI-assisted development) as a test bed for the marketing stack, running the full site, form and tracking chain on one domain.</li>
            <li><strong>Form to server pipeline:</strong> Built the form-to-server pipeline from scratch; each submission writes to both Cloudflare D1 and Notion, and a hidden field stores the GA4 Client ID on the lead record, verified in GA4 DebugView.</li>
            <li><strong>Web and server-side tracking:</strong> Configured GTM + GA4 web tracking and stood up a Server-Side GTM test environment (Stape), getting GA4 server-side forwarding running.</li>
            <li><strong>Debugging and write-up:</strong> Independently traced a GA4 page_view drop (other events firing normally, no request sent) to manually entered session_id / session_number in the Google tag overriding GA4 session parameters; the fix passed regression testing and was written up as a public post-mortem.</li>
            <li>Built personal workflows on AI and automation tools such as Dify and Notion, extracting unstructured information from web pages and documents and converting it into structured, reusable data processes.</li>
          </ul>
        </div>

        <div class="job">
          <div class="job-head">
            <span class="job-title">Bonree Data</span>
            <span class="job-date">Jan 2025 - Sep 2025</span>
          </div>
          <div class="job-meta">Overseas Digital Marketing ｜ Computer Software</div>
          <ul class="job-points">
            <li>Joined at the zero-to-one stage of the company's global business; owned demand generation and marketing technology build-out to support the overseas market launch.</li>
            <li><strong>0→1 global digital marketing build:</strong> Independently planned and shipped the website, ad platforms, marketing stack and lead management process, establishing a complete demand generation foundation for the overseas business.</li>
            <li><strong>Marketing stack:</strong> Independently deployed and implemented Google Ads, LinkedIn Ads, GA4, GTM, Zoho Forms and ShareCRM, connecting marketing tracking, lead capture and the underlying data flow.</li>
            <li><strong>Marketing automation &amp; CRM:</strong> Designed the global lead management process, building form automation, email notifications, data sync and lead routing mechanisms to improve lead handoff efficiency.</li>
            <li><strong>Global brand &amp; operations:</strong> Ran the global website, LinkedIn company page and PR distribution, steadily improving brand visibility and digital operations capability.</li>
          </ul>
        </div>

        <div class="job">
          <div class="job-head">
            <span class="job-title">hireEZ</span>
            <span class="job-date">May 2021 - Jul 2024</span>
          </div>
          <div class="job-meta">Sr. Marketing Operations ｜ IT Services</div>
          <ul class="job-points">
            <li>Global B2B AI recruiting SaaS company; owned marketing operations for North America and global markets, covering demand generation, ad conversion attribution, CRM and sales lead operations, marketing automation and cross-system data coordination.</li>
            <li><strong>Demand generation:</strong> Ran overseas ad channels including Google Ads and LinkedIn Ads at roughly USD 800K in annual spend; lifted Google Ads ROAS from 3.7 to 14.32 (about 3.87&times;), contributing to 2.5&times; ARR growth.</li>
            <li><strong>Offline conversion feedback:</strong> Fed Salesforce lead and sales-stage data back to the ad platforms as offline conversions, judging channel performance by lead quality and downstream conversion to guide optimisation and budget shifts.</li>
            <li><strong>Marketing data tracking &amp; attribution:</strong> Led the Universal Analytics to GA4 migration, building and maintaining web event collection and conversion tracking in GTM, establishing the data and attribution foundation for channel analysis and ad optimisation.</li>
            <li><strong>Site conversion testing:</strong> Ran page and conversion-path tests with Google Optimize, GTM and VWO, validating change hypotheses and giving the business a basis for rolling a variant out or dropping it.</li>
            <li><strong>Salesforce CRM operations:</strong> Ran day-to-day Salesforce operations and business configuration, maintaining core objects and fields (Lead, Contact, Account, Campaign, Opportunity), configuring validation rules, formula logic and dependent picklists, and managing user accounts and permissions; added a validation requirement for the disqualification reason when a Lead moves to Disqualified.</li>
            <li><strong>CRM data quality:</strong> Audited business data through Salesforce reports, data exports and Excel cleaning — resolving duplicate Leads, Contacts and Accounts, missing values and inconsistent field formats — and matched records across systems to improve CRM data completeness and usability.</li>
            <li><strong>Lead management &amp; routing:</strong> Maintained LeanData routing rules, assigning leads by their match to existing Accounts plus region, country and company size; used routing logs to trace misroutes, missed assignments and stalled lead flows.</li>
            <li><strong>Sales operations reporting:</strong> Built custom Salesforce reports and dashboards monitoring Opportunity pipeline, SDR-owned account status and lead performance; combined related datasets as needed and debugged report fields, filters and data logic to support Marketing and Sales.</li>
            <li><strong>CRM Analytics integration:</strong> Built data recipes and dashboards in CRM Analytics (CRMA), joining, cleaning and aggregating Salesforce, Pardot and Google Analytics (UA/GA4) data; used recipes to process the latest campaign activity and write it back to Salesforce Contacts.</li>
            <li><strong>Marketing automation &amp; nurture:</strong> Ran Pardot day to day, creating and maintaining marketing forms, lead processing actions and automated flows; used Engagement Studio to segment audiences and manage lists by region, campaign and account attributes for programmes such as product launches, trade shows and the Academy.</li>
            <li><strong>ABM segmentation &amp; activation:</strong> Contributed to 6sense ABM operations, maintaining target-account segments from existing ICP, buying stage and account behaviour; ran segmentation and data orchestration against SDR requests and pushed segments into Salesforce for targeted marketing and sales alignment.</li>
            <li><strong>Cross-system operations &amp; troubleshooting:</strong> Analysed cross-platform campaign performance through the Google Ads–Pardot campaign mapping; traced Pardot–Salesforce sync failures, and when routing broke, followed LeanData logs upstream to 6sense field sync and data-format issues to keep the marketing and CRM platforms in step.</li>
          </ul>
        </div>

        <div class="job">
          <div class="job-head"><span class="job-title">Hirect</span><span class="job-date">Mar 2021 - May 2021</span></div>
          <div class="job-meta">Global Paid Media Manager ｜ IT Services</div>
        </div>
        <div class="job">
          <div class="job-head"><span class="job-title">HiStudio</span><span class="job-date">May 2020 - Mar 2021</span></div>
          <div class="job-meta">Global Channel Optimization Specialist</div>
        </div>
        <div class="job">
          <div class="job-head"><span class="job-title">LeadsCloud</span><span class="job-date">Feb 2019 - Jan 2020</span></div>
          <div class="job-meta">Optimization Specialist ｜ IT Services</div>
        </div>
        <div class="job">
          <div class="job-head"><span class="job-title">Chengde Lolo</span><span class="job-date">Nov 2017 - Oct 2018</span></div>
          <div class="job-meta">New Media Specialist ｜ FMCG</div>
        </div>
        <div class="job">
          <div class="job-head"><span class="job-title">Beijing Denong</span><span class="job-date">May 2017 - Nov 2017</span></div>
          <div class="job-meta">Research Assistant</div>
        </div>
      </section>

      <!-- Skills -->
      <section class="r-section" id="skills">
        <h2 class="r-h">Skills</h2>
        <div class="skill-group">
          <span class="skill-label">Focus areas</span>
          <span class="skill-items">Marketing Operations ｜ Marketing Systems ｜ Marketing Automation ｜ CRM</span>
        </div>
        <div class="skill-group">
          <span class="skill-label">Platforms</span>
          <div class="tags">
            <span class="tag">Google Ads</span><span class="tag">LinkedIn Ads</span><span class="tag">GA4</span>
            <span class="tag">Google Tag Manager</span><span class="tag">Server-Side GTM</span><span class="tag">VWO</span><span class="tag">Salesforce</span><span class="tag">Pardot</span>
            <span class="tag">6sense</span><span class="tag">Zoho</span><span class="tag">ShareCRM</span>
          </div>
        </div>
        <div class="skill-group">
          <span class="skill-label">Data &amp; analytics</span>
          <span class="skill-items">Lead Management ｜ Marketing Analytics ｜ SQL ｜ Looker Studio ｜ CRMA</span>
        </div>
      </section>

      <!-- Education -->
      <section class="r-section" id="contact">
        <h2 class="r-h">Education</h2>
        <div class="edu-item">
          <span><span class="edu-name">University of Nottingham</span> <span class="edu-degree">Agronomy · M.Sc.</span></span>
          <span class="edu-date">Sep 2015 - Dec 2016</span>
        </div>
        <div class="edu-item">
          <span><span class="edu-name">China Agricultural University</span> <span class="edu-degree">Agronomy · B.Sc.</span></span>
          <span class="edu-date">Sep 2011 - Jul 2015</span>
        </div>
      </section>

      <div class="resume-actions">
        {
          resumePdf ? (
            <>
              <a class="btn btn-primary" href={resumePdf} download>Download PDF</a>
              <button class="btn btn-ghost" id="printBtn" type="button">Print</button>
            </>
          ) : (
            <button class="btn btn-primary" id="printBtn" type="button">Download / Print PDF</button>
          )
        }
      </div>
    </div>
  </div>
</BaseLayout>

{/* is:inline：不让 Astro/Vite 打包压缩，构建产物里保持可读 */}
<script is:inline>
  /* 打印 / 导出 PDF —— 用浏览器原生打印，不引入额外依赖 */
  document.getElementById("printBtn")?.addEventListener("click", () => window.print());
</script>
