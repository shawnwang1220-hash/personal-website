---
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { SITE } from "../../../site.config";
import { withTrailingSlash } from "../../../i18n/config";
import { getUiCopy } from "../../../i18n/ui";

const lang = "en" as const;
const t = getUiCopy(lang);

export const getStaticPaths = (async () => {
  const posts = await getCollection("postsEn", ({ data }) => !data.draft);
  const sorted = posts.sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );

  return sorted.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      prev: sorted[i - 1] ?? null,
      next: sorted[i + 1] ?? null,
    },
  }));
}) satisfies GetStaticPaths;

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, tags } = post.data;

const dateText = pubDate.toISOString().slice(0, 10);

// 与 canonical 保持一致：指向带尾斜杠的最终地址，而不是会被 308 的地址
const postUrl = new URL(withTrailingSlash(`/en/posts/${post.id}`), SITE.url).href;

/**
 * 本页专属节点。author / publisher 引用的 #person 由 BaseLayout 注入到同一份
 * @graph 内 —— @id 不能跨页面解析，本页没有对应节点就会变成「有引用、无定义」
 * 的悬空引用，作者与发布者信息整段失效。
 */
const jsonLd = {
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  inLanguage: "en",
  keywords: tags.join(", "),
  url: postUrl,
  mainEntityOfPage: { "@type": "WebPage", "@id": postUrl },
  author: { "@id": `${SITE.url}/#person` },
  publisher: { "@id": `${SITE.url}/#person` },
};
---

<BaseLayout lang={lang} title={title} description={description} ogType="article" jsonLd={jsonLd}>
  <section class="section container" style="max-width: 780px;">
    <a class="back-link" href="/en/posts/">{t.post.backLink}</a>

    <article class="card reveal">
      <header class="post-head">
        <h1>{title}</h1>
        <div class="post-meta">
          <time datetime={pubDate.toISOString()}>{dateText}</time>
          {
            tags.length > 0 && (
              <>
                <span class="dot" />
                <span class="post-tags">
                  {tags.map((tag) => (
                    <a class="tag" href={`/en/tags/${encodeURIComponent(tag)}/`}>
                      {tag}
                    </a>
                  ))}
                </span>
              </>
            )
          }
        </div>
      </header>

      <div class="markdown-body">
        <Content />
      </div>
    </article>

    <nav class="post-nav">
      {prev ? <a href={`/en/posts/${prev.id}/`}>← {prev.data.title}</a> : <span />}
      {next ? <a href={`/en/posts/${next.id}/`}>{next.data.title} →</a> : <span />}
    </nav>
  </section>
</BaseLayout>
