---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { SITE } from "../../site.config";
import { getSiteCopy, getUiCopy } from "../../i18n/ui";
import { Content as AboutContent } from "../../data/about.en.md";

const lang = "en" as const;
const copy = getSiteCopy(lang);
const t = getUiCopy(lang);

const posts = (await getCollection("postsEn", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const latest = posts.slice(0, 3);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${SITE.url}/#person`,
      name: copy.author.name,
      alternateName: copy.author.alternateName,
      url: SITE.url,
      jobTitle: copy.author.role,
      description: copy.author.summary,
      address: {
        "@type": "PostalAddress",
        addressLocality: copy.author.location,
        addressCountry: "CN",
      },
      knowsAbout: copy.stack,
      sameAs: [copy.social.github],
    },
    {
      "@type": "WebSite",
      "@id": `${SITE.url}/#website`,
      url: SITE.url,
      name: copy.title,
      description: copy.description,
      inLanguage: "en",
      publisher: { "@id": `${SITE.url}/#person` },
    },
  ],
};
---

<BaseLayout lang={lang} jsonLd={jsonLd}>
  <!-- ===== Hero ===== -->
  <section class="hero container" id="hero">
    <div class="hero-card reveal">
      <img src="/avatar.svg" alt={t.home.heroPortraitAlt} class="hero-avatar" />
      <h1 class="hero-name">
        {t.home.heroGreeting} <span class="accent">{t.home.heroName}</span> {t.home.heroWave}
      </h1>
      <p class="hero-role">{copy.author.role}</p>
      <p class="hero-tagline">{copy.author.summary}</p>
      <div class="hero-buttons">
        <a class="btn btn-primary" href="/en/posts">{t.home.ctaPosts}</a>
        <a class="btn btn-ghost" href="/en/resume">{t.home.ctaResume}</a>
      </div>
      <div class="hero-socials" aria-label={t.home.socialsAria}>
        <a href={copy.social.github} target="_blank" rel="noopener" title="GitHub">
          <svg viewBox="0 0 24 24" class="ic" aria-hidden="true"><path d="M12 .5C5.37.5 0 5.78 0 12.29c0 5.21 3.44 9.62 8.21 11.18.6.11.82-.26.82-.58 0-.29-.01-1.04-.02-2.05-3.34.72-4.04-1.6-4.04-1.6-.55-1.38-1.34-1.75-1.34-1.75-1.09-.74.08-.73.08-.73 1.2.08 1.84 1.23 1.84 1.23 1.07 1.82 2.81 1.29 3.5.99.11-.77.42-1.29.76-1.59-2.67-.3-5.47-1.32-5.47-5.87 0-1.3.47-2.36 1.24-3.19-.13-.3-.54-1.52.12-3.16 0 0 1.01-.32 3.3 1.22a11.6 11.6 0 0 1 6 0c2.29-1.54 3.3-1.22 3.3-1.22.66 1.64.25 2.86.12 3.16.77.83 1.23 1.89 1.23 3.19 0 4.56-2.81 5.56-5.49 5.86.43.37.81 1.1.81 2.22 0 1.6-.01 2.89-.01 3.28 0 .32.21.7.82.58A12.01 12.01 0 0 0 24 12.29C24 5.78 18.63.5 12 .5z"/></svg>
          GitHub
        </a>
        <a href="/en/rss.xml" title="RSS feed">
          <svg viewBox="0 0 24 24" class="ic" aria-hidden="true"><path d="M4 11a9 9 0 0 1 9 9h-2a7 7 0 0 0-7-7v-2zm0-7a16 16 0 0 1 16 16h-2A14 14 0 0 0 4 6V4zm0 14a2 2 0 1 1 0 4 2 2 0 0 1 0-4z"/></svg>
          RSS
        </a>
      </div>
    </div>
  </section>

  <!-- ===== About ===== -->
  <section class="section container" id="about">
    <h2 class="section-title reveal"><span class="accent">#</span> {t.home.aboutHeading}</h2>
    <div class="about-grid">
      <article class="card markdown-body reveal">
        <AboutContent />
      </article>
      <aside class="card side-card reveal">
        <h3>{t.home.factsHeading}</h3>
        <ul class="facts">
          {copy.facts.map((f) => <li><strong>{f.label}:</strong> {f.value}</li>)}
        </ul>
        <h3>{t.home.stackHeading}</h3>
        <div class="tags">
          {copy.stack.map((s) => <span class="tag">{s}</span>)}
        </div>
      </aside>
    </div>
  </section>

  <!-- ===== Latest posts ===== -->
  <section class="section container" id="articles">
    <h2 class="section-title reveal"><span class="accent">#</span> {t.home.latestHeading}</h2>
    <p class="section-sub reveal">
      {t.home.postCount(posts.length)} · <a href="/en/posts">{t.home.viewAll}</a>
    </p>
    <div class="post-grid">
      {latest.map((post) => <PostCard post={post} lang={lang} />)}
    </div>
  </section>
</BaseLayout>
