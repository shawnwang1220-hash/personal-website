---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import StatCard from "../../components/StatCard.astro";
import PostCard from "../../components/PostCard.astro";
import TimelineItem from "../../components/TimelineItem.astro";
import CaseCard from "../../components/CaseCard.astro";
import HireCTA from "../../components/HireCTA.astro";
import { getSiteCopy, getUiCopy } from "../../i18n/ui";

const lang = "en" as const;
const copy = getSiteCopy(lang);
const t = getUiCopy(lang);

const posts = (await getCollection("postsEn", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const latest = posts.slice(0, 3);

const experiences = (await getCollection("experienceEn")).sort((a, b) =>
  b.data.start.localeCompare(a.data.start)
);

const cases = (await getCollection("casesEn")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// Person / WebSite 节点由 BaseLayout 统一注入，首页不再自行声明（避免两份真源）
---

<BaseLayout lang={lang}>
  <Hero lang={lang} />

  {/* ===== Stat cards: four fixed-metric proof points ===== */}
  <section class="section container" aria-label={t.home.statsAria}>
    <div class="stats-grid">
      {copy.stats.map((s) => <StatCard value={s.value} label={s.label} />)}
    </div>
  </section>

  {/* ===== Latest posts ===== */}
  <section class="section container" id="articles">
    <div class="section-head reveal">
      <h2 class="section-title"><span class="accent">#</span> {t.home.latestHeading}</h2>
      <p class="section-sub">{t.home.postCount(posts.length)} · <a href="/en/posts/">{t.home.viewAll}</a></p>
    </div>
    <div class="post-grid">
      {latest.map((post) => <PostCard post={post} lang={lang} compact />)}
    </div>
  </section>

  {/* ===== Experience summary (same source as /experience, collapsed by default) ===== */}
  <section class="section container" id="experience">
    <div class="section-head reveal">
      <h2 class="section-title"><span class="accent">#</span> {t.home.experienceHeading}</h2>
      <p class="section-sub"><a href="/en/experience/">{t.home.experienceAll}</a></p>
    </div>
    {
      experiences.length > 0 && (
        <ul class="timeline">
          {experiences.map((item) => <TimelineItem item={item} lang={lang} />)}
        </ul>
      )
    }
  </section>

  {/* ===== Featured cases (same source as /case) ===== */}
  <section class="section container" id="cases">
    <div class="section-head reveal">
      <h2 class="section-title"><span class="accent">#</span> {t.home.caseHeading}</h2>
      <p class="section-sub"><a href="/en/case/">{t.home.caseAll}</a></p>
    </div>
    {
      cases.length > 0 && (
        <div class="case-grid">
          {cases.map((item) => <CaseCard item={item} lang={lang} />)}
        </div>
      )
    }
  </section>

  {/* ===== Hire me CTA ===== */}
  <section class="section container">
    <HireCTA lang={lang} />
  </section>
</BaseLayout>
