---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import StatCard from "../components/StatCard.astro";
import PostCard from "../components/PostCard.astro";
import TimelineItem from "../components/TimelineItem.astro";
import CaseCard from "../components/CaseCard.astro";
import HireCTA from "../components/HireCTA.astro";
import { getSiteCopy, getUiCopy } from "../i18n/ui";

const copy = getSiteCopy("zh");
const t = getUiCopy("zh");

const posts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latest = posts.slice(0, 3);

/* start 为 "2025.10" 形态，倒序按字典序即可 */
const experiences = (await getCollection("experience")).sort((a, b) =>
  b.data.start.localeCompare(a.data.start)
);

const cases = (await getCollection("cases")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// Person / WebSite 节点由 BaseLayout 统一注入，首页不再自行声明（避免两份真源）
---

<BaseLayout>
  <Hero lang="zh" />

  {/* ===== 数据卡：四个固定口径的成绩 ===== */}
  <section class="section container" aria-label={t.home.statsAria}>
    <div class="stats-grid">
      {copy.stats.map((s) => <StatCard value={s.value} label={s.label} />)}
    </div>
  </section>

  {/* ===== 最新文章 ===== */}
  <section class="section container" id="articles">
    <div class="section-head reveal">
      <h2 class="section-title"><span class="accent">#</span> {t.home.latestHeading}</h2>
      <p class="section-sub">{t.home.postCount(posts.length)} · <a href="/posts/">{t.home.viewAll}</a></p>
    </div>
    <div class="post-grid">
      {latest.map((post) => <PostCard post={post} compact />)}
    </div>
  </section>

  {/* ===== 经历摘要（与 /experience 同源，默认折叠） ===== */}
  <section class="section container" id="experience">
    <div class="section-head reveal">
      <h2 class="section-title"><span class="accent">#</span> {t.home.experienceHeading}</h2>
      <p class="section-sub"><a href="/experience/">{t.home.experienceAll}</a></p>
    </div>
    {
      experiences.length > 0 && (
        <ul class="timeline">
          {experiences.map((item) => <TimelineItem item={item} lang="zh" />)}
        </ul>
      )
    }
  </section>

  {/* ===== 案例精选（与 /case 同源） ===== */}
  <section class="section container" id="cases">
    <div class="section-head reveal">
      <h2 class="section-title"><span class="accent">#</span> {t.home.caseHeading}</h2>
      <p class="section-sub"><a href="/case/">{t.home.caseAll}</a></p>
    </div>
    {
      cases.length > 0 && (
        <div class="case-grid">
          {cases.map((item) => <CaseCard item={item} lang="zh" />)}
        </div>
      )
    }
  </section>

  {/* ===== Hire me CTA ===== */}
  <section class="section container">
    <HireCTA lang="zh" />
  </section>
</BaseLayout>
