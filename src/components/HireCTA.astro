---
import { SITE } from "../site.config";
import { getUiCopy } from "../i18n/ui";
import type { Lang } from "../i18n/config";

interface Props {
  lang: Lang;
  /**
   * 以下四项可选，用于在别的语境下复用同一套 CTA（如案例详情页）：
   * 首页与 /hire 页不传，直接用 t.hire 的默认文案。
   *
   * 之所以不另建 CaseCTA 组件：占位邮箱降级规则与 .hire-cta 样式只应有一份真源，
   * 复制一套会在两处各留一个「邮箱换成真实地址后忘了改」的坑。
   */
  heading?: string;
  text?: string;
  /** 服务标签；显式传空数组可隐藏该行（案例页不需要） */
  services?: readonly string[];
  cta?: string;
}

const { lang, heading, text, services, cta } = Astro.props;
const t = getUiCopy(lang);
const serviceList = services ?? t.hire.services;

/**
 * 占位邮箱（your@* / *@example.com）不渲染 mailto 按钮 ——
 * 与简历页共用同一套规则，避免对外输出指向不存在地址的链接。
 * 站长在 site.config.ts 填入真实 hireEmail 后按钮自动生效。
 */
const isPlaceholder =
  !SITE.hireEmail ||
  SITE.hireEmail.startsWith("your@") ||
  SITE.hireEmail.includes("example.com");
---

<div class="hire-cta reveal">
  <h2>{heading ?? t.hire.title}</h2>
  <p>{text ?? t.hire.text}</p>
  {
    serviceList.length > 0 && (
      <div class="hire-services">
        {serviceList.map((s) => (
          <span class="tag">{s}</span>
        ))}
      </div>
    )
  }
  {
    isPlaceholder ? (
      <>
        <span class="btn btn-primary" aria-disabled="true">{cta ?? t.hire.cta}</span>
        <p class="hire-note">{t.hire.note}</p>
      </>
    ) : (
      <a class="btn btn-primary" href={`mailto:${SITE.hireEmail}`}>{cta ?? t.hire.cta}</a>
    )
  }
</div>
