---
import { getSiteCopy, getUiCopy } from "../i18n/ui";
import { LANG_META, getLangFromPath, swapLangPath, withTrailingSlash } from "../i18n/config";
import type { Lang } from "../i18n/config";

interface Props {
  lang?: Lang;
  /** 另一语言版本的路径；标签页需显式传入（标签本身会被翻译） */
  altPath?: string;
}

const { lang = getLangFromPath(Astro.url.pathname), altPath } = Astro.props;

const copy = getSiteCopy(lang);
const t = getUiCopy(lang);
const otherLang: Lang = lang === "zh" ? "en" : "zh";
const otherMeta = LANG_META[otherLang];

/** 当前语言的首页地址：中文 "/"，英文 "/en/" */
const homeHref = withTrailingSlash(lang === "en" ? "/en" : "/");

/** 语言切换目标地址 */
const altHref = withTrailingSlash(altPath ?? swapLangPath(Astro.url.pathname));

// 两边都归一化（去掉尾斜杠）再比较，避免 /posts/ 与 /posts 被当成两个页面
const bare = (p: string) => p.replace(/\/+$/, "") || "/";
const current = bare(Astro.url.pathname);
const homeBare = bare(homeHref);
const isActive = (href: string) => {
  const h = bare(href);
  return h === homeBare ? current === h : current === h || current.startsWith(`${h}/`);
};
---

<header class="site-header" id="top">
  <nav class="nav container">
    <a class="brand" href={homeHref} aria-label={t.brandAria}>
      <img src="/avatar.svg" alt="" class="brand-avatar" />
      <span>{t.brandName}</span>
    </a>

    <ul class="nav-links" id="navLinks">
      {
        copy.nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="nav-actions">
      <a
        class="lang-switch"
        href={altHref}
        hreflang={otherMeta.htmlLang}
        lang={otherMeta.htmlLang}
        aria-label={LANG_META[lang].switchAria}
        title={LANG_META[lang].switchAria}>{LANG_META[lang].switchShort}</a
      >
      <button
        class="theme-toggle"
        id="themeToggle"
        type="button"
        aria-label={t.themeToggleAria}
        title={t.themeToggleAria}
      >
        <span class="theme-icon">🌙</span>
      </button>
      <button
        class="hamburger"
        id="hamburger"
        type="button"
        aria-label={t.menuAria}
        aria-expanded="false"
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </nav>
</header>

{/* is:inline：不让 Astro/Vite 打包压缩，构建产物里保持可读 */}
<script is:inline>
  /* 主题切换 —— 与 BaseLayout 里的防闪屏脚本共享 localStorage 键 */
  const toggle = document.getElementById("themeToggle");
  const icon = toggle?.querySelector(".theme-icon");

  function applyTheme(theme) {
    document.documentElement.setAttribute("data-theme", theme);
    if (icon) icon.textContent = theme === "dark" ? "☀️" : "🌙";
    try {
      localStorage.setItem("blog-theme", theme);
    } catch {}
  }

  if (icon) {
    icon.textContent =
      document.documentElement.getAttribute("data-theme") === "dark" ? "☀️" : "🌙";
  }

  toggle?.addEventListener("click", () => {
    const cur = document.documentElement.getAttribute("data-theme");
    applyTheme(cur === "dark" ? "light" : "dark");
  });

  /* 移动端菜单 */
  const hamburger = document.getElementById("hamburger");
  const navLinks = document.getElementById("navLinks");
  if (hamburger && navLinks) {
    hamburger.addEventListener("click", () => {
      const open = navLinks.classList.toggle("open");
      hamburger.classList.toggle("open", open);
      hamburger.setAttribute("aria-expanded", String(open));
    });
    navLinks.querySelectorAll("a").forEach((a) =>
      a.addEventListener("click", () => {
        navLinks.classList.remove("open");
        hamburger.classList.remove("open");
        hamburger.setAttribute("aria-expanded", "false");
      })
    );
  }
</script>
