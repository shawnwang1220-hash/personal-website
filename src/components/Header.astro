---
import { getSiteCopy, getUiCopy } from "../i18n/ui";
import { LANG_META, getLangFromPath, swapLangPath, withTrailingSlash } from "../i18n/config";
import type { Lang } from "../i18n/config";

interface Props {
  lang?: Lang;
  /** 另一语言版本的路径；标签页需显式传入（标签本身会被翻译） */
  altPath?: string;
}

const { lang = getLangFromPath(Astro.url.pathname), altPath } = Astro.props;

const copy = getSiteCopy(lang);
const t = getUiCopy(lang);
const otherLang: Lang = lang === "zh" ? "en" : "zh";
/** 目标语言元信息：hreflang / lang 描述的是链接目标与按钮文字的语言 */
const otherMeta = LANG_META[otherLang];
/**
 * 当前语言元信息：切换按钮的文案与 aria 取这里（中文页显示 "EN"、英文页显示 "中"）。
 * 取成 otherMeta 会让标签与跳转方向相反 —— 中文页显示「中」却跳去英文站。
 */
const langMeta = LANG_META[lang];

/** 当前语言的首页地址：中文 "/"，英文 "/en/" */
const homeHref = withTrailingSlash(lang === "en" ? "/en" : "/");

/** 语言切换目标地址 */
const altHref = withTrailingSlash(altPath ?? swapLangPath(Astro.url.pathname));

/**
 * Hire me CTA：仅当 nav 配置了 cta 项时渲染。
 * 目标页未上线时不放死链 —— /hire 落地（C6）后再在 site.config.ts 启用。
 */
const ctaItem = copy.nav.find((item) => item.cta);
const textLinks = copy.nav.filter((item) => !item.cta);

// 两边都归一化（去掉尾斜杠）再比较，避免 /posts/ 与 /posts 被当成两个页面
const bare = (p: string) => p.replace(/\/+$/, "") || "/";
const current = bare(Astro.url.pathname);
const homeBare = bare(homeHref);
const isActive = (href: string) => {
  const h = bare(href);
  return h === homeBare ? current === h : current === h || current.startsWith(`${h}/`);
};
---

<header class="site-header" id="top">
  <nav class="nav container" aria-label={t.navAria}>
    <a class="brand" href={homeHref} aria-label={t.brandAria}>
      <img src="/avatar.svg" alt="" class="brand-avatar" />
      <span>{t.brandName}</span>
    </a>

    <ul class="nav-links" id="navLinks">
      {
        textLinks.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="nav-spacer"></div>

    <div class="nav-actions">
      {ctaItem && <a class="nav-cta" href={ctaItem.href}>{ctaItem.label}</a>}

      {/* 语言切换：中 / EN 文字小按钮，沿用镜像路径推导机制 */}
      <a
        class="icon-btn lang-switch"
        href={altHref}
        hreflang={otherMeta.htmlLang}
        lang={otherMeta.htmlLang}
        aria-label={langMeta.switchAria}
        title={langMeta.switchAria}>{langMeta.switchShort}</a
      >

      {/* 主题切换：太阳/月亮图标纯 CSS 显隐（亮→月，暗→日），
          aria-label / title 由下方脚本按当前主题刷新为「点击后的动作」 */}
      <button
        class="icon-btn theme-toggle"
        id="themeToggle"
        type="button"
        aria-label={t.themeToDarkAria}
        title={t.themeToDarkAria}
        data-label-light={t.themeToDarkAria}
        data-label-dark={t.themeToLightAria}
      >
        <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" /></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" /></svg>
      </button>

      {/* 移动端汉堡：其余导航链接收进下拉菜单 */}
      <button
        class="hamburger"
        id="hamburger"
        type="button"
        aria-label={t.menuAria}
        aria-expanded="false"
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </nav>
</header>

{/* is:inline：不让 Astro/Vite 打包压缩，构建产物里保持可读 */}
<script is:inline>
  /* 主题切换 —— 与 BaseLayout 里的防闪屏脚本共享 localStorage 键 */
  const toggle = document.getElementById("themeToggle");

  function currentTheme() {
    return document.documentElement.getAttribute("data-theme") === "dark" ? "dark" : "light";
  }

  function applyTheme(theme) {
    document.documentElement.setAttribute("data-theme", theme);
    /* 无障碍标签与图标（目标模式）保持一致 */
    if (toggle) {
      const label = theme === "dark" ? toggle.dataset.labelDark : toggle.dataset.labelLight;
      if (label) {
        toggle.setAttribute("aria-label", label);
        toggle.setAttribute("title", label);
      }
    }
    try {
      localStorage.setItem("blog-theme", theme);
    } catch {}
  }

  /* 首屏同步：data-theme 已由渲染前脚本设好，这里只校准按钮的无障碍标签 */
  if (toggle) {
    const label = currentTheme() === "dark" ? toggle.dataset.labelDark : toggle.dataset.labelLight;
    if (label) {
      toggle.setAttribute("aria-label", label);
      toggle.setAttribute("title", label);
    }
  }

  toggle?.addEventListener("click", () => {
    applyTheme(currentTheme() === "dark" ? "light" : "dark");
  });

  /* 移动端菜单 */
  const hamburger = document.getElementById("hamburger");
  const navLinks = document.getElementById("navLinks");
  if (hamburger && navLinks) {
    hamburger.addEventListener("click", () => {
      const open = navLinks.classList.toggle("open");
      hamburger.classList.toggle("open", open);
      hamburger.setAttribute("aria-expanded", String(open));
    });
    navLinks.querySelectorAll("a").forEach((a) =>
      a.addEventListener("click", () => {
        navLinks.classList.remove("open");
        hamburger.classList.remove("open");
        hamburger.setAttribute("aria-expanded", "false");
      })
    );
  }
</script>
