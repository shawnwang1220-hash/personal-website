---
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { getUiCopy } from "../i18n/ui";
import type { Lang } from "../i18n/config";

interface Props {
  item: CollectionEntry<"experience"> | CollectionEntry<"experienceEn">;
  lang: Lang;
  /** 职位标题层级：/experience 页传 h2（页面级标题），首页摘要用默认 h3 */
  as?: "h2" | "h3";
}

const { item, lang, as: Heading = "h3" } = Astro.props;
const t = getUiCopy(lang);
const { company, role, start, end, summary, highlights } = item.data;

/* markdown 正文整体折叠进 <details>：内容详略两种情况下时间线都不塌 */
const { Content } = await render(item);
---

<li class="timeline-item reveal">
  <div class="timeline-date">
    {start} – {end}
  </div>
  <Heading class="timeline-role">{role}</Heading>
  <div class="timeline-company">{company}</div>
  {summary && <p class="timeline-summary">{summary}</p>}

  <details>
    <summary>{t.experience.detailsLabel}</summary>
    <div class="timeline-detail markdown-body">
      {highlights.length > 0 && (
        <ul>
          {highlights.map((h) => <li>{h}</li>)}
        </ul>
      )}
      <Content />
    </div>
  </details>
</li>
