---
import { SITE } from "../site.config";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <p>© {year} 王天旭 · 数字营销与 MarTech.</p>
    <p class="footer-sub">
      由 <a href="https://astro.build" target="_blank" rel="noopener">Astro</a> 构建 ·
      内容以 Markdown 维护 ·
      <a href="/rss.xml">RSS</a>
    </p>
  </div>
</footer>

<button class="back-to-top" id="backToTop" type="button" aria-label="返回顶部" title="返回顶部">
  ↑
</button>

<script>
  /* 返回顶部 */
  const backToTop = document.getElementById("backToTop");
  if (backToTop) {
    window.addEventListener("scroll", () => {
      backToTop.classList.toggle("show", window.scrollY > 400);
    });
    backToTop.addEventListener("click", () =>
      window.scrollTo({ top: 0, behavior: "smooth" })
    );
  }

  /* 滚动揭示动画
   * 注意：类名必须是 .in —— global.css 里 .reveal 初始 opacity: 0，
   * 写错类名会让内容对用户永久不可见（爬虫不受影响，但用户体验崩了）。
   * 不支持 IntersectionObserver 时直接全部显示。 */
  const revealEls = document.querySelectorAll<HTMLElement>(".reveal");
  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add("in");
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.12 }
    );
    revealEls.forEach((el) => io.observe(el));
  } else {
    revealEls.forEach((el) => el.classList.add("in"));
  }
</script>
