---
import { getUiCopy } from "../i18n/ui";
import { getLangFromPath } from "../i18n/config";
import type { Lang } from "../i18n/config";
import { SITE } from "../site.config";

interface Props {
  lang?: Lang;
}

const { lang = getLangFromPath(Astro.url.pathname) } = Astro.props;

const t = getUiCopy(lang);
const langPrefix = lang === "en" ? "/en" : "";
const year = new Date().getFullYear();
const host = new URL(SITE.url).host;
---

<footer class="site-footer">
  <div class="container footer-inner">
    <p>{t.footer.copyright(year)} · {host}</p>
    <p class="footer-sub"><a href={`${langPrefix}/rss.xml`}>{t.footer.rss}</a></p>
  </div>
</footer>

<button class="back-to-top" id="backToTop" type="button" aria-label={t.backToTop} title={t.backToTop}>
  ↑
</button>

{/* is:inline：不让 Astro/Vite 打包压缩，构建产物里保持可读 */}
<script is:inline>
  /* 返回顶部 */
  const backToTop = document.getElementById("backToTop");
  if (backToTop) {
    window.addEventListener("scroll", () => {
      backToTop.classList.toggle("show", window.scrollY > 400);
    });
    backToTop.addEventListener("click", () =>
      window.scrollTo({ top: 0, behavior: "smooth" })
    );
  }

  /* 滚动揭示动画 —— 顺序不能反
   * 1) 先确认 IntersectionObserver 可用，可用才给 html 加 .js（CSS 里只有 .js .reveal 才隐藏）
   * 2) 再注册 observer，进视口加 .in 放出来
   * 任何一步没成（脚本被拦截 / 不支持 / 构造抛错），.js 就不该存在，内容保持可见。
   * 注意：不要把初始 opacity 写回 global.css 的 .reveal 上，那等于把内容可见性
   * 押在 JS 上，脚本一挂页面就整片空白（爬虫看得见、人看不见）。 */
  (function () {
    var root = document.documentElement;
    var els = document.querySelectorAll(".reveal");
    if (!els.length) return;
    if (!("IntersectionObserver" in window)) return;

    root.classList.add("js");
    try {
      var io = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) {
              e.target.classList.add("in");
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12 }
      );
      els.forEach(function (el) {
        io.observe(el);
      });
    } catch (err) {
      /* 兜底：observer 挂了就把内容全部放出来，不留半截隐藏 */
      root.classList.remove("js");
    }
  })();
</script>
