---
import { getUiCopy } from "../i18n/ui";
import { getLangFromPath } from "../i18n/config";
import type { Lang } from "../i18n/config";

interface Props {
  lang?: Lang;
}

const { lang = getLangFromPath(Astro.url.pathname) } = Astro.props;

const t = getUiCopy(lang);
const langPrefix = lang === "en" ? "/en" : "";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <p>{t.footer.copyright(year)}</p>
    <p class="footer-sub">
      {t.footer.builtWith} <a href="https://astro.build" target="_blank" rel="noopener">Astro</a> {t
        .footer.builtSuffix} ·
      <a href={`${langPrefix}/rss.xml`}>RSS</a>
    </p>
  </div>
</footer>

<button class="back-to-top" id="backToTop" type="button" aria-label={t.backToTop} title={t.backToTop}>
  ↑
</button>

{/* is:inline：不让 Astro/Vite 打包压缩，构建产物里保持可读 */}
<script is:inline>
  /* 返回顶部 */
  const backToTop = document.getElementById("backToTop");
  if (backToTop) {
    window.addEventListener("scroll", () => {
      backToTop.classList.toggle("show", window.scrollY > 400);
    });
    backToTop.addEventListener("click", () =>
      window.scrollTo({ top: 0, behavior: "smooth" })
    );
  }

  /* 滚动揭示动画
   * 注意：类名必须是 .in —— global.css 里 .reveal 初始 opacity: 0，
   * 写错类名会让内容对用户永久不可见（爬虫不受影响，但用户体验崩了）。
   * 不支持 IntersectionObserver 时直接全部显示。 */
  const revealEls = document.querySelectorAll(".reveal");
  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add("in");
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.12 }
    );
    revealEls.forEach((el) => io.observe(el));
  } else {
    revealEls.forEach((el) => el.classList.add("in"));
  }
</script>
