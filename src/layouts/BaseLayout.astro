---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../site.config";
import { getSiteCopy } from "../i18n/ui";
import { LANG_META, getLangFromPath, swapLangPath, withTrailingSlash } from "../i18n/config";
import type { Lang } from "../i18n/config";

interface Props {
  title?: string;
  description?: string;
  ogType?: "website" | "article";
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  bodyClass?: string;
  /** 当前页面语言；默认由 URL 自动判断（/en 前缀 → en） */
  lang?: Lang;
  /**
   * 另一语言版本的路径（以 / 开头）。
   * 默认按「英文 = /en + 中文路径」的镜像规则推导；
   * 标签页因标签本身会被翻译，需要显式传入。
   */
  altPath?: string;
}

const {
  title,
  description,
  ogType = "website",
  jsonLd,
  noindex = false,
  bodyClass = "",
  lang = getLangFromPath(Astro.url.pathname),
  altPath,
} = Astro.props;

const copy = getSiteCopy(lang);
const meta = LANG_META[lang];

const pageTitle = title ?? copy.title;
const pageDescription = description ?? copy.description;

// 语言前缀：中文无前缀，英文挂在 /en 下
const langPrefix = lang === "en" ? "/en" : "";

// canonical / hreflang 一律指向「最终地址」——带尾斜杠，与 sitemap 保持一致。
// 无斜杠的地址会被 Cloudflare Pages 308 到带斜杠版本，指向它等于指向重定向目标。
const path = Astro.url.pathname;
const absolute = (p: string) => new URL(withTrailingSlash(p), SITE.url).href;

const canonical = absolute(path);

// 页面标题：子页面追加作者名，首页直接用站点名
const fullTitle = pageTitle === copy.title ? copy.title : `${pageTitle} · ${copy.author.name}`;

// 中英互链：当前语言用自己的路径，另一语言取 altPath 或按镜像规则推导
const otherPath = altPath ?? swapLangPath(path);
const pathZh = lang === "zh" ? path : otherPath;
const pathEn = lang === "en" ? path : otherPath;

const personLd = {
  "@type": "Person",
  "@id": `${SITE.url}/#person`,
  name: copy.author.name,
  alternateName: copy.author.alternateName,
  url: SITE.url,
  jobTitle: copy.author.role,
  description: copy.author.summary,
  address: {
    "@type": "PostalAddress",
    addressLocality: copy.author.location,
    addressCountry: "CN",
  },
  sameAs: [copy.social.github],
};

/**
 * Google Tag Manager 官方标准嵌入代码。
 *
 * 用 set:html + is:inline 原样输出，而不是 define:vars —— define:vars 会自动包一层
 * (function(){ const gtmId = "..." })()，构建产物里首行被压平，和内联脚本的排版风格不一致。
 *
 * 模板字符串的缩进 = 产物中 <script> 内的最终缩进（刻意写成 6 空格），开头的换行是为了
 * 让内容不与 <script> 标签挤在同一行。调整缩进时记得同步。
 *
 * 中英页面共用同一段注入代码、同一容器 ID：本站的语言版本只是路由差异，
 * 不改变 GTM 的加载时机与方式，避免引入新的变量干扰 GTM 行为排查。
 */
const gtmSnippet = SITE.gtmId
  ? `
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != "dataLayer" ? "&l=" + l : "";
        j.async = true;
        j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, "script", "dataLayer", "${SITE.gtmId}");
    `
  : "";
---

<!doctype html>
<html lang={meta.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {/* ════════ GA4 page_view 排查临时插桩 —— 排查结束请整段删除（BEGIN） ════════ */}
    {/* 目的：在 GTM/gtag 运行前包裹所有上报通道，记录「是否尝试发 /g/collect」+「尝试结果」 */}
    {/* 读取：Console 跑 copy(JSON.stringify(window.__diag, null, 1)) */}
    <script is:inline>
      (function () {
        var t0 = Date.now();
        var L = [];
        window.__diag = L;
        function rec(o) {
          o.t = Date.now() - t0;
          L.push(o);
        }
        var HIT = /\/g\/collect|gtag\/js|gtm\.js/;
        function u(a) {
          try {
            return a && a.url ? a.url : String(a);
          } catch (e) {
            return "?";
          }
        }

        /* 1. dataLayer：先建后钩，记录 gtag 的 config / event 调用 */
        try {
          window.dataLayer = window.dataLayer || [];
          var dl = window.dataLayer;
          if (!dl.__hooked) {
            var origPush = dl.push;
            dl.push = function () {
              try {
                var a = arguments[0];
                var k = a && a[0];
                if (
                  k === "config" ||
                  k === "event" ||
                  k === "consent" ||
                  k === "js" ||
                  k === "set"
                ) {
                  rec({ ch: "dataLayer", phase: String(k), arg: String(a[1] || "") });
                }
              } catch (e) {}
              return origPush.apply(this, arguments);
            };
            dl.__hooked = true;
            rec({ ch: "init", phase: "dataLayer-hooked", len: dl.length });
          }
        } catch (e) {
          rec({ ch: "init", phase: "dataLayer-hook-failed", err: String(e) });
        }

        /* 2. fetch */
        var _f = window.fetch;
        if (_f) {
          window.fetch = function () {
            var url = u(arguments[0]);
            if (!HIT.test(url)) return _f.apply(this, arguments);
            rec({
              ch: "fetch",
              phase: "call",
              url: url,
              keepalive: !!(arguments[1] && arguments[1].keepalive),
            });
            var p = _f.apply(this, arguments);
            try {
              p.then(
                function (r) {
                  rec({ ch: "fetch", phase: "resolve", status: r.status, type: r.type, url: url });
                },
                function (e) {
                  rec({ ch: "fetch", phase: "reject", err: String((e && e.message) || e), url: url });
                }
              );
            } catch (e) {}
            return p;
          };
        }

        /* 3. sendBeacon */
        if (navigator.sendBeacon) {
          var _sb = navigator.sendBeacon.bind(navigator);
          navigator.sendBeacon = function (url, data) {
            if (!HIT.test(String(url))) return _sb(url, data);
            var ok;
            try {
              ok = _sb(url, data);
            } catch (e) {
              rec({ ch: "beacon", phase: "throw", err: String(e), url: String(url) });
              throw e;
            }
            rec({
              ch: "beacon",
              phase: ok ? "accepted" : "queue-failed",
              url: String(url),
              bytes: (data && (data.length || data.byteLength)) || 0,
            });
            return ok;
          };
        }

        /* 4. XMLHttpRequest */
        var _open = XMLHttpRequest.prototype.open;
        var _send = XMLHttpRequest.prototype.send;
        XMLHttpRequest.prototype.open = function (m, url) {
          this.__u = String(url);
          return _open.apply(this, arguments);
        };
        XMLHttpRequest.prototype.send = function () {
          var x = this;
          if (x.__u && HIT.test(x.__u)) {
            rec({ ch: "xhr", phase: "send", url: x.__u });
            x.addEventListener("loadend", function () {
              rec({
                ch: "xhr",
                phase: "done",
                status: x.status,
                err: x.status === 0 ? "net-error" : "",
                url: x.__u,
              });
            });
          }
          return _send.apply(this, arguments);
        };

        /* 5. Image（gtag 老式 transport 兜底） */
        try {
          var RealImg = window.Image;
          var d = Object.getOwnPropertyDescriptor(RealImg.prototype, "src");
          if (d && d.set) {
            window.Image = function () {
              var img = new RealImg();
              Object.defineProperty(img, "src", {
                configurable: true,
                get: function () {
                  return d.get.call(img);
                },
                set: function (v) {
                  if (/collect/.test(String(v))) {
                    rec({ ch: "img", phase: "set", url: String(v) });
                    img.addEventListener("load", function () {
                      rec({ ch: "img", phase: "load", url: String(v) });
                    });
                    img.addEventListener("error", function () {
                      rec({ ch: "img", phase: "error", url: String(v) });
                    });
                  }
                  d.set.call(img, v);
                },
              });
              return img;
            };
            window.Image.prototype = RealImg.prototype;
          }
        } catch (e) {}

        /* 6. 生命周期 */
        window.addEventListener("pagehide", function () {
          rec({ ch: "life", phase: "pagehide" });
        });
        document.addEventListener("visibilitychange", function () {
          rec({ ch: "life", phase: "visibilitychange", vis: document.visibilityState });
        });
        document.addEventListener("prerenderingchange", function () {
          rec({ ch: "life", phase: "prerenderingchange", pre: document.prerendering });
        });

        /* 7. 启动快照 */
        rec({
          ch: "init",
          phase: "boot",
          pre: !!document.prerendering,
          vis: document.visibilityState,
          href: location.href,
        });
      })();
    </script>
    {/* ════════ GA4 page_view 排查临时插桩（END） ════════ */}

    <title>{fullTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {/* 中英互链。404 之类的 noindex 页面不输出，避免给搜索引擎指路 */}
    {
      !noindex && (
        <>
          <link rel="alternate" hreflang="zh-CN" href={absolute(pathZh)} />
          <link rel="alternate" hreflang="en" href={absolute(pathEn)} />
          <link rel="alternate" hreflang="x-default" href={absolute(pathZh)} />
        </>
      )
    }

    <meta name="author" content={copy.author.name} />
    {/* favicon 是 public 根下的静态资源，没有语言版本，不加 /en 前缀 */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={copy.title}
      href={`${langPrefix}/rss.xml`}
    />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={copy.title} />
    <meta property="og:locale" content={meta.ogLocale} />
    <meta property="og:locale:alternate" content={LANG_META[lang === "zh" ? "en" : "zh"].ogLocale} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={pageDescription} />

    {/* JSON-LD 用 2 空格缩进输出，构建产物里可读（对搜索引擎无影响） */}
    {
      jsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd, null, 2)}
          is:inline
        />
      )
    }

    {/* 深色模式：在渲染前定好主题，避免白屏闪烁 */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("blog-theme");
          if (!t) {
            t = window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
          }
          document.documentElement.setAttribute("data-theme", t);
        } catch (e) {}
      })();
    </script>

    {/* GTM：is:inline + set:html 原样输出，产物里保持可读（详见 frontmatter 的 gtmSnippet） */}
    {SITE.gtmId && <script is:inline set:html={gtmSnippet} />}
  </head>

  <body class={bodyClass}>
    {
      SITE.gtmId && (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${SITE.gtmId}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"
          />
        </noscript>
      )
    }

    <Header lang={lang} altPath={altPath} />

    <main>
      <slot />
    </main>

    <Footer lang={lang} />
  </body>
</html>
