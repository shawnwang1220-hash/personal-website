---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../site.config";

interface Props {
  title?: string;
  description?: string;
  ogType?: "website" | "article";
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  bodyClass?: string;
}

const {
  title = SITE.title,
  description = SITE.description,
  ogType = "website",
  jsonLd,
  noindex = false,
  bodyClass = "",
} = Astro.props;

// 规范化成绝对地址，canonical 不带尾斜杠（除根路径）
const path = Astro.url.pathname;
const canonical = new URL(path === "/" ? "/" : path.replace(/\/$/, ""), SITE.url).href;

// 页面标题：子页面追加站点名，首页直接用站点名
const fullTitle = title === SITE.title ? SITE.title : `${title} · 王天旭`;

const personLd = {
  "@type": "Person",
  "@id": `${SITE.url}/#person`,
  name: SITE.author.name,
  alternateName: SITE.author.alternateName,
  url: SITE.url,
  jobTitle: SITE.author.role,
  description: SITE.author.summary,
  address: {
    "@type": "PostalAddress",
    addressLocality: SITE.author.location,
    addressCountry: "CN",
  },
  sameAs: [SITE.social.github],
};

/**
 * Google Tag Manager 官方标准嵌入代码。
 *
 * 用 set:html + is:inline 原样输出，而不是 define:vars —— define:vars 会自动包一层
 * (function(){ const gtmId = "..." })()，构建产物里首行被压平，和内联脚本的排版风格不一致。
 *
 * 模板字符串的缩进 = 产物中 <script> 内的最终缩进（刻意写成 6 空格），开头的换行是为了
 * 让内容不与 <script> 标签挤在同一行。调整缩进时记得同步。
 */
const gtmSnippet = SITE.gtmId
  ? `
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != "dataLayer" ? "&l=" + l : "";
        j.async = true;
        j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, "script", "dataLayer", "${SITE.gtmId}");
    `
  : "";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta name="author" content={SITE.author.name} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href="/rss.xml"
    />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    {/* JSON-LD 用 2 空格缩进输出，构建产物里可读（对搜索引擎无影响） */}
    {
      jsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd, null, 2)}
          is:inline
        />
      )
    }

    {/* 深色模式：在渲染前定好主题，避免白屏闪烁 */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("blog-theme");
          if (!t) {
            t = window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
          }
          document.documentElement.setAttribute("data-theme", t);
        } catch (e) {}
      })();
    </script>

    {/* GTM：is:inline + set:html 原样输出，产物里保持可读（详见 frontmatter 的 gtmSnippet） */}
    {SITE.gtmId && <script is:inline set:html={gtmSnippet} />}
  </head>

  <body class={bodyClass}>
    {
      SITE.gtmId && (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${SITE.gtmId}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"
          />
        </noscript>
      )
    }

    <Header />

    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>
